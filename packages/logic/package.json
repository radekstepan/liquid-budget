{
  "name": "@ynab/logic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "echo \"(no lint configured)\" && exit 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
