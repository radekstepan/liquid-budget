{
  "name": "@ynab/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "echo \"(no lint configured)\" && exit 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "yarn build && node dist/db-reset.js"
  },
  "dependencies": {
    "@ynab/logic": "workspace:*",
    "better-sqlite3": "11.10.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.15",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
