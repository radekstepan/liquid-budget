{
  "name": "@ynab/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "clean": "rm -rf .next",
    "lint": "echo \"(no lint configured)\" && exit 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:server": "E2E_TESTING=true yarn dev --port 3000",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@ynab/logic": "workspace:*",
    "@ynab/server": "workspace:*",
    "@ynab/ui": "workspace:*",
    "adm-zip": "^0.6.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.1.17",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
