# Copy to `.env.local` and fill in to enable optional AI features.
# Next.js loads `.env.local` automatically; this example file is inert.
# `.env`, `.env.local`, and `.env.*.local` are git-ignored — never commit keys.

# ---------------------------------------------------------------------------
# AI payee rename suggestions ("Suggest with AI" on the rename-rules page).
# Uses any OpenAI-compatible chat API. The button is hidden unless BOTH
# LLM_API_KEY and LLM_MODEL are set.
# ---------------------------------------------------------------------------

# API key for the chat service. Required to enable suggestions.
#LLM_API_KEY=sk-...

# Chat model to use. Required to enable suggestions.
# Cheap + great on OpenRouter for this task:
#LLM_MODEL=google/gemini-2.5-flash-lite
# OpenAI equivalent:
#LLM_MODEL=gpt-4o-mini

# Base URL of an OpenAI-compatible API. Optional.
# Defaults to https://api.openai.com/v1. Examples for local/alternative
# providers (key may be any non-empty string for keyless local servers):
#LLM_BASE_URL=http://localhost:11434/v1
#LLM_BASE_URL=https://openrouter.ai/api/v1

# Per-request timeout in milliseconds. Optional, defaults to 60000.
#LLM_TIMEOUT_MS=60000

# Max distinct payees covered per click. Optional, defaults to 200.
# Payees are sent in batches of 10 with a % progress readout on the button.
#LLM_MAX_PAYEES=200
